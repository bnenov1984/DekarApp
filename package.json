{
  "name": "areaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AreaFlow — Spatial Intelligence Platform (Phase 4 implementation)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json",
